{
  "name": "@proliferate/mobile",
  "version": "0.1.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build:shared": "pnpm --filter @proliferate/cloud-sdk build && pnpm --filter @proliferate/cloud-sdk-react build && pnpm --filter @anyharness/sdk build && pnpm --filter @anyharness/sdk-react build && pnpm --filter @proliferate/design build && pnpm --filter @proliferate/product-domain build",
    "start": "pnpm build:shared && expo start",
    "ios": "pnpm build:shared && expo start --ios",
    "android": "pnpm build:shared && expo start --android",
    "web": "pnpm build:shared && expo start --web",
    "web:profile": "pnpm build:shared && expo start --web --host localhost --port ${PROLIFERATE_MOBILE_WEB_PORT:-5175}",
    "typecheck": "pnpm build:shared && tsc --noEmit",
    "test": "vitest run",
    "build:ios": "pnpm build:shared && pnpm dlx eas-cli@21.0.2 build --platform ios --profile production",
    "build:ios:preview": "pnpm build:shared && pnpm dlx eas-cli@21.0.2 build --platform ios --profile preview",
    "eas-build-post-install": "pnpm build:shared",
    "submit:ios": "pnpm dlx eas-cli@21.0.2 submit --platform ios --profile production"
  },
  "dependencies": {
    "@anyharness/sdk": "workspace:*",
    "@anyharness/sdk-react": "workspace:*",
    "@proliferate/cloud-sdk": "workspace:*",
    "@proliferate/cloud-sdk-react": "workspace:*",
    "@proliferate/design": "workspace:*",
    "@proliferate/product-domain": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~56.0.16",
    "expo-apple-authentication": "~56.0.4",
    "expo-application": "~56.0.3",
    "expo-blur": "^56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.21",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-glass-effect": "~56.0.4",
    "expo-linking": "~56.0.15",
    "expo-localization": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.21",
    "expo-router": "~56.2.15",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.13",
    "expo-status-bar": "~56.0.4",
    "posthog-react-native": "^4.56.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.17",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  },
  "expo": {
    "install": {
      "//": "Held out of SDK version-matching so `expo install --fix`/expo-doctor don't realign them. The React family stays at 19.2 (react-native 0.85 peers react ^19.2.0). TypeScript stays at the monorepo-wide ^5.7 (=5.9.x): SDK 56 prefers TS 6.0, but the shared @proliferate/* packages built during `mobile typecheck` still use tsconfig `baseUrl` (removed in TS 6/7), so the workspace moves to TS 6 as one migration, not here.",
      "exclude": [
        "react",
        "react-dom",
        "@types/react",
        "typescript"
      ]
    }
  }
}
