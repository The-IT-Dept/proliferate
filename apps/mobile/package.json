{
  "name": "@proliferate/mobile",
  "version": "0.1.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:shared": "pnpm --filter @proliferate/cloud-sdk build && pnpm --filter @proliferate/cloud-sdk-react build && pnpm --filter @proliferate/design build && pnpm --filter @proliferate/product-domain build",
    "start": "pnpm build:shared && expo start",
    "ios": "pnpm build:shared && expo start --ios",
    "android": "pnpm build:shared && expo start --android",
    "web": "pnpm build:shared && expo start --web",
    "web:profile": "pnpm build:shared && expo start --web --host localhost --port ${PROLIFERATE_MOBILE_WEB_PORT:-5175}",
    "typecheck": "pnpm build:shared && tsc --noEmit",
    "build:ios": "pnpm build:shared && pnpm dlx eas-cli@18.13.0 build --platform ios --profile production",
    "build:ios:preview": "pnpm build:shared && pnpm dlx eas-cli@18.13.0 build --platform ios --profile preview",
    "eas-build-post-install": "pnpm build:shared",
    "submit:ios": "pnpm dlx eas-cli@18.13.0 submit --platform ios --profile production"
  },
  "dependencies": {
    "@anyharness/sdk": "workspace:*",
    "@proliferate/cloud-sdk": "workspace:*",
    "@proliferate/cloud-sdk-react": "workspace:*",
    "@proliferate/design": "workspace:*",
    "@proliferate/product-domain": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.15",
    "expo-application": "~55.0.17",
    "expo-blur": "^55.0.16",
    "expo-clipboard": "~55.0.15",
    "expo-crypto": "~55.0.17",
    "expo-device": "~55.0.19",
    "expo-file-system": "~55.0.24",
    "expo-linking": "~55.0.16",
    "expo-localization": "~55.0.17",
    "expo-secure-store": "~55.0.16",
    "expo-splash-screen": "~55.0.23",
    "expo-status-bar": "~55.0.6",
    "posthog-react-native": "^4.56.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.17",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "//": "The React family is intentionally held at 19.2 across the SDK upgrade (react-native 0.85 peers react ^19.2.0); opt it out of SDK version-matching so `expo install --fix` and expo-doctor do not try to realign it.",
      "exclude": [
        "react",
        "react-dom",
        "@types/react"
      ]
    }
  }
}
